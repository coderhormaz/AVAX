
# =============================================================================
# STORAGE CONFIGURATION (Required for NFT uploads)
# =============================================================================

# Lighthouse Storage API Key (Primary IPFS provider)
# Get your API key from: https://lighthouse.storage/
VITE_LIGHTHOUSE_API_KEY=4df30ae3.b2ff47caf81e4764bc41458037cae8b4

# Pinata JWT Token (Alternative IPFS provider)
# Get your JWT from: https://pinata.cloud/
VITE_PINATA_JWT=

# =============================================================================
# BLOCKCHAIN CONFIGURATION
# =============================================================================

# Network Selection (MAINNET only)
VITE_CURRENT_NETWORK=MAINNET

# Contract Addresses (Fill after deploying contracts via Remix)
# Smart Contract Addresses (Update these after deployment)
VITE_MASTER_FACTORY_ADDRESS=

# =============================================================================
# WALLET CONFIGURATION
# =============================================================================

# Minimum AVAX balance required for AI features
VITE_MIN_AVAX_BALANCE=0.01

# Local storage key name for wallet data
VITE_WALLET_STORAGE_KEY=avax_wallet_key

# =============================================================================
# CUSTOM RPC ENDPOINTS (Optional - defaults provided)
# =============================================================================

# Custom Avalanche Mainnet RPC (optional)
VITE_MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc

# =============================================================================
# INSTRUCTIONS
# =============================================================================
#
# 1. Copy this file to .env.local
# 2. Fill in your API keys (remove the # and add your keys)
# 3. Deploy smart contracts using Remix IDE
# 4. Add contract addresses above
# 5. Restart your development server (npm run dev)
#
# SECURITY NOTE:
# - .env.local is gitignored and won't be committed
# - Never commit API keys to version control
# - Use different API keys for development vs production
#
